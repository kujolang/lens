{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kujolang/lens/flow.schema.json",
  "title": "Lens flow",
  "description": "A Lens browser flow. Lens executes and verifies it deterministically; agents author it. See docs/flow-authoring.md.",
  "type": "object",
  "required": ["name", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "description": "Human label shown in reports." },
    "description": { "type": "string" },
    "url": { "type": "string", "description": "Starting URL. Localhost unless allow_external is true." },
    "viewports": {
      "type": "array",
      "items": { "type": "string", "description": "desktop | mobile | WxH (e.g. 1280x800)" },
      "default": ["desktop"]
    },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 20 },
    "allow_external": { "type": "boolean", "default": false },
    "allow_destructive": { "type": "boolean", "default": false },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        { "required": ["visit"], "properties": { "visit": { "type": "string" } } },
        { "required": ["click"], "properties": { "click": { "type": "object", "required": ["selector", "safe"], "properties": { "selector": { "type": "string" }, "safe": { "type": "boolean" }, "destructive": { "type": "boolean" } } } } },
        { "required": ["type"], "properties": { "type": { "type": "object", "required": ["selector"], "properties": { "selector": { "type": "string" }, "value": { "type": "string" }, "secret": { "type": "boolean" } } } } },
        { "required": ["scroll"], "properties": { "scroll": { "type": "object", "properties": { "selector": { "type": "string" }, "y": { "type": "integer" } } } } },
        { "required": ["wait_for_selector"], "properties": { "wait_for_selector": { "type": "string" } } },
        { "required": ["wait_for_text"], "properties": { "wait_for_text": { "type": "string" } } },
        { "required": ["assert_selector"], "properties": { "assert_selector": { "type": "string" } } },
        { "required": ["assert_not_selector"], "properties": { "assert_not_selector": { "type": "string" } } },
        { "required": ["assert_text"], "properties": { "assert_text": { "type": "string" } } },
        { "required": ["screenshot"], "properties": { "screenshot": { "type": "object", "properties": { "name": { "type": "string" } } } } },
        { "required": ["wait"], "properties": { "wait": { "type": "object", "properties": { "ms": { "type": "integer", "minimum": 0, "maximum": 10000 } } } } },
        { "required": ["assert_no_console_errors"] },
        { "required": ["assert_no_failed_requests"] }
      ]
    }
  }
}
