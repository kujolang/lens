# src/integrations.kujo — Lens ecosystem integrations (Phase 3.3 / 3.4).
#
# Optional, side-effect-free by default. Each integration writes a compact,
# redacted record to a caller-provided path; absence of the flag is a no-op.
# These never include unredacted data — they consume already-redacted summary
# values (status, counts, redacted URL).

from src.common import is_trueish, is_falseish, str_ends_with, str_trim

# Append a RunLedger-compatible record (Phase 3.3).
#
# RunLedger records runs for trend analysis. We append one JSON object per line
# (JSONL) so successive runs accumulate without rewriting prior history. The
# record is intentionally small and contains no captured page data.
export func write_ledger_record(path, tool_version, redacted_url, status, exit_code, started_at, finished_at, duration_ms, counts) {
	record := {
		"schema_version": 1,
		"tool": "lens",
		"tool_version": tool_version,
		"url": redacted_url,
		"status": status,
		"exit_code": exit_code,
		"started_at": started_at,
		"finished_at": finished_at,
		"duration_ms": duration_ms,
		"findings": counts
	}
	line := to_json(record)

	# Keep the established newline repair for records from older writers.
	# Keep the same 8 MiB budget across supported Kujo runtimes.
	mut separator := ""
	try {
		mut existing_size := 0
		if is_trueish(file_exists(path)) { existing_size = file_size(path) }
		if existing_size + len(line) * 4 + 2 > 8 * 1024 * 1024 { return false }
		if existing_size > 0 && is_falseish(str_ends_with(read_file(path), "\n")) {
			separator = "\n"
		}
		return append_file(path, separator + line + "\n")
	} except e {
		return false
	}
}

# Write a Howl pass/fail summary (Phase 3.4).
#
# Howl surfaces a concise run outcome. We write a single, current-run summary
# (overwriting any prior) with just the verdict, counts, and report pointer.
export func write_howl_summary(path, tool_version, redacted_url, status, exit_code, duration_ms, counts, report_path) {
	emoji := "✅"
	if status != "PASS" {
		emoji = "❌"
	}
	summary := {
		"tool": "lens",
		"tool_version": tool_version,
		"emoji": emoji,
		"headline": emoji + " Lens " + status + " — " + redacted_url,
		"status": status,
		"exit_code": exit_code,
		"duration_ms": duration_ms,
		"findings": counts,
		"report": report_path
	}
	return write_direct_artifact(path, to_json(summary))
}

# Use a short staging name for caller-selected filenames. Kujo's atomic writer
# incorporates the target basename into its temporary name, which can exceed
# the filesystem's limit even when the requested basename is valid.
export func write_direct_artifact(path, contents) {
	mut parent := dirname(path)
	if parent == "" { parent = "." }
	temp := spawn_process(array("mktemp", parent + "/.lens-artifact.XXXXXXXX"))
	if is_falseish(temp.success) { return false }
	staged := str_trim(to_string(temp.stdout))
	try {
		write_file_atomic(staged, contents, true)
		return rename_file(staged, path)
	} except e {
		delete_file(staged)
		return false
	}
}
