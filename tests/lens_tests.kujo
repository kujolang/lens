# ── Redaction: free text ─────────────────────────────────────────────

func test_redact_text_bearer() {
	r := redact_text("Auth failed Bearer abc123XYZ789tokenvalue")
	check(is_falseish(contains(r, "abc123XYZ789tokenvalue")), "redact_text: bearer token value removed")
	check(is_trueish(contains(r, "[REDACTED]")), "redact_text: bearer redaction marker present")
}

func test_redact_text_query_params() {
	r := redact_text("GET http://h/api/data?token=supersecret123&page=1")
	check(is_falseish(contains(r, "supersecret123")), "redact_text: query token removed")
	check(is_trueish(contains(r, "page=1")), "redact_text: benign query param preserved")
}

func test_redact_text_password_and_jwt() {
	check(is_falseish(contains(redact_text("login password=hunter2secret"), "hunter2secret")), "redact_text: password removed")
	check(is_falseish(contains(redact_text("jwt eyJhbGci.eyJzdWIi.SflKxwRJ done"), "eyJhbGci")), "redact_text: JWT removed")
}

func test_redact_text_preserves_benign() {
	r := redact_text("normal page text q=hello page=2 monkey=1")
	check(is_trueish(contains(r, "q=hello")), "redact_text: benign q preserved")
	check(is_trueish(contains(r, "monkey=1")), "redact_text: short key=value not over-redacted")
}

func test_redact_url_basic_auth_and_fragment() {
	r := redact_url("https://user:pass@host.com/x?api_key=zzzsecretval#frag")
	check(is_falseish(contains(r, "user:pass")), "redact_url: basic-auth credentials removed")
	check(is_falseish(contains(r, "zzzsecretval")), "redact_url: sensitive param removed")
	check(is_trueish(contains(r, "#frag")), "redact_url: fragment preserved")
}

# ── Redaction: structured ────────────────────────────────────────────

func test_redact_finding_scrubs_text() {
	f := {
		"id": "X1", "check_name": "CONSOLE", "severity": "error",
		"title": "Console error: Bearer SEKRETabcdef123456",
		"description": "request to http://h/?token=leakvalue1",
		"evidence": "network.json",
		"suggested_repair_task": "fix it"
	}
	rf := redact_finding(f)
	check_eq(rf["id"], "X1", "redact_finding: id preserved")
	check_eq(rf["severity"], "error", "redact_finding: severity preserved")
	check(is_falseish(contains(to_string(rf["title"]), "SEKRETabcdef123456")), "redact_finding: title secret removed")
	check(is_falseish(contains(to_string(rf["description"]), "leakvalue1")), "redact_finding: description secret removed")
}

func test_redact_check_results_sweep() {
	cr := new_check_result("Console", "console_errors")
	cr = add_finding(cr, new_finding("error", "CONSOLE", "Console error: Bearer LEAKTOKENabcdef123", "saw ?token=qsecretval99 here", "ev", "repair"))
	swept := redact_check_results(array(cr))
	check_eq(swept[0]["id"], "console_errors", "sweep: check id preserved")
	fnd := swept[0]["findings"][0]
	check(is_falseish(contains(to_string(fnd["title"]), "LEAKTOKENabcdef123")), "sweep: finding title scrubbed")
	check(is_falseish(contains(to_string(fnd["description"]), "qsecretval99")), "sweep: finding description scrubbed")
	check_eq(to_string(fnd["severity"]), "error", "sweep: finding severity preserved")
}

func test_redact_check_results_preserves_engine_fields() {
	cr := new_check_result("Accessibility", "accessibility")
	cr["engine_available"] = true
	cr["engine_version"] = "4.11.4"
	swept := redact_check_results(array(cr))
	check(swept[0]["engine_available"] == true, "sweep: engine_available preserved")
	check_eq(swept[0]["engine_version"], "4.11.4", "sweep: engine_version preserved")
}

func test_redact_console_message() {
	msg := {"type": "error", "text": "Bearer TOKENVALUEabcdef1234", "location": "http://h/?token=locsecret1:1:2", "timestamp": "t", "viewport": "desktop"}
	r := redact_console_message(msg)
	check_eq(r["type"], "error", "console msg: type preserved")
	check(is_falseish(contains(to_string(r["text"]), "TOKENVALUEabcdef1234")), "console msg: text scrubbed")
	check(is_falseish(contains(to_string(r["location"]), "locsecret1")), "console msg: location scrubbed")
}

func test_redact_network_event_whitelist() {
	ev := {"url": "http://h/api?api_key=netsecret123", "method": "GET", "status": 404, "request_headers": {"Authorization": "Bearer x"}, "request_body": "secret body"}
	r := redact_network_event(ev)
	check(is_falseish(contains(to_string(r["url"]), "netsecret123")), "net event: url scrubbed")
	check_eq(r["status"], 404, "net event: status preserved")
	check(is_falseish(has_key(r, "request_headers")), "net event: headers not retained")
	check(is_falseish(has_key(r, "request_body")), "net event: body not retained")
}

func test_redact_dom_summary() {
	ds := {"viewport": "desktop", "url": "http://h/?token=domleak1", "visible_text_sample": "key=abcdef1234567 shown", "title": "T"}
	r := redact_dom_summary(ds)
	check(is_falseish(contains(to_string(r["url"]), "domleak1")), "dom: url scrubbed")
	check(is_falseish(contains(to_string(r["visible_text_sample"]), "abcdef1234567")), "dom: visible text sample scrubbed")
}

# ── Provider: partial-failure resilience (determinism) ───────────────

func test_provider_failed_partial_ok() {
	partial := {
		"viewports": array(
			{"name": "desktop", "dom_summary": {"x": 1}, "navigation_error": null},
			{"name": "mobile", "dom_summary": null, "screenshot": "", "navigation_error": "timeout"}
		),
		"provider_errors": array("Viewport 'mobile' navigation error: timeout")
	}
	check(provider_failed(partial) == false, "provider_failed: partial data is NOT a total failure")
}

func test_provider_failed_error_flag() {
	total := {"error": true, "viewports": array(), "provider_errors": array("Browser launch failed")}
	check(provider_failed(total) == true, "provider_failed: explicit error flag is total failure")
}

func test_provider_failed_empty_viewports() {
	empty := {"viewports": array(), "provider_errors": array()}
	check(provider_failed(empty) == true, "provider_failed: empty viewports is total failure")
}

# ── Page-load classification ─────────────────────────────────────────

func test_check_page_load_partial_error() {
	bd := {"provider_result": {"viewports": array(
		{"name": "desktop", "navigation_error": null, "dom_summary": {}},
		{"name": "mobile", "navigation_error": "timeout"}
	)}}
	cr := check_page_load({}, bd)
	check_eq(cr["severity"], "error", "page_load: partial nav error -> error severity")
}

func test_check_page_load_all_failed() {
	bd := {"provider_result": {"viewports": array(
		{"name": "desktop", "navigation_error": "x"},
		{"name": "mobile", "navigation_error": "y"}
	)}}
	cr := check_page_load({}, bd)
	check_eq(cr["severity"], "critical", "page_load: all viewports failed -> critical")
}

func test_check_page_load_clean() {
	bd := {"provider_result": {"viewports": array(
		{"name": "desktop", "navigation_error": null, "dom_summary": {}}
	)}}
	cr := check_page_load({}, bd)
	check_eq(cr["status"], "pass", "page_load: clean navigation -> pass")
}

# ── Accessibility: honest engine handling ────────────────────────────

func test_a11y_engine_unavailable_is_skipped() {
	bd := {"provider_result": {"viewports": array(
		{"name": "desktop", "accessibility": {"engine_available": false, "error": "axe-core not installed"}}
	)}}
	cfg := {"accessibility": true, "url": "http://localhost"}
	cr := check_accessibility(cfg, bd)
	check_eq(cr["status"], "skipped", "a11y: engine unavailable -> skipped, never a clean pass")
	check(cr["engine_available"] == false, "a11y: engine_available false recorded")
}

func test_a11y_real_violation_fails() {
	bd := {"provider_result": {"viewports": array(
		{"name": "desktop", "accessibility": {"engine_available": true, "version": "4.11.4", "violations": array(
			{"id": "image-alt", "impact": "critical", "description": "d", "help": "h", "help_url": "u", "node_count": 1}
		)}}
	)}}
	cfg := {"accessibility": true, "url": "http://localhost"}
	cr := check_accessibility(cfg, bd)
	check_eq(cr["status"], "fail", "a11y: critical violation -> fail")
	check_eq(cr["finding_count"], 1, "a11y: one finding recorded")
	check(cr["engine_available"] == true, "a11y: engine_available true recorded")
}

# ── Visual: binary-safe copy ─────────────────────────────────────────

func test_copy_file_binary() {
	src := "/tmp/lens_copy_src_test.bin"
	dst := "/tmp/lens_copy_dst_test.bin"
	# Clean up any artifacts from a previous test run (write_file refuses
	# to overwrite an existing file).
	if is_trueish(file_exists(src)) { delete_file(src) }
	if is_trueish(file_exists(dst)) { delete_file(dst) }
	write_file(src, "lens copy test payload")
	ok := copy_file_binary(src, dst)
	check(ok == true, "copy_file_binary: returns true on success")
	check(is_trueish(file_exists(dst)), "copy_file_binary: destination created")
	missing := copy_file_binary("/tmp/lens_nonexistent_xyz.bin", "/tmp/lens_copy_none.bin")
	check(missing == false, "copy_file_binary: false when source missing")
}

