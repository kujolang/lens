func test_provider_result_shape() {
	# Verify that a minimal provider result has the expected shape.
	mock := {
		"url": "http://test",
		"final_url": "http://test",
		"started_at": "2026-01-01T00:00:00Z",
		"finished_at": "2026-01-01T00:00:01Z",
		"duration_ms": 1000,
		"viewports": array(),
		"provider_errors": array(),
		"metadata": {}
	}
	check(is_trueish(has_key(mock, "url")), "provider result: has url")
	check(is_trueish(has_key(mock, "viewports")), "provider result: has viewports")
	check(is_trueish(has_key(mock, "provider_errors")), "provider result: has provider_errors")
	check(is_trueish(has_key(mock, "metadata")), "provider result: has metadata")
}

func test_viewport_config_mapping() {
	# Verify viewport name mapping.
	check_eq(parse_viewport("desktop"), "desktop", "viewport: desktop maps correctly")
	check_eq(parse_viewport("mobile"), "mobile", "viewport: mobile maps correctly")
	check_eq(parse_viewport("DESKTOP"), "desktop", "viewport: case insensitive")
	check_eq(parse_viewport("invalid"), "", "viewport: invalid returns empty")
}

func test_artifact_paths_for_screenshots() {
	# Verify screenshot paths follow expected pattern.
	vp_results := array(
		{
			"name": "desktop",
			"screenshot": "/tmp/out/screenshots/desktop.png"
		},
		{
			"name": "mobile",
			"screenshot": "/tmp/out/screenshots/mobile.png"
		}
	)
	mut paths := array()
	mut idx := 0
	while idx < len(vp_results) {
		vp := vp_results[idx]
		paths = append(paths, "screenshots/" + to_string(vp["name"]) + ".png")
		idx = idx + 1
	}
	check_eq(paths[0], "screenshots/desktop.png", "artifact: desktop screenshot path")
	check_eq(paths[1], "screenshots/mobile.png", "artifact: mobile screenshot path")
}

func test_provider_failure_scenario() {
	# Verify provider_failed detects errors.
	mock_ok := {
		"viewports": array({"name": "desktop"}),
		"provider_errors": array()
	}
	mock_fail := {
		"viewports": array(),
		"provider_errors": array("Browser launch failed")
	}
	# Mock ok should not be failed
	check_eq(len(mock_ok["viewports"]) > 0, true, "provider: ok has viewports")
	check_eq(len(mock_ok["provider_errors"]) == 0, true, "provider: ok has no errors")
	# Mock fail should be detected
	check_eq(len(mock_fail["viewports"]) == 0, true, "provider: fail has no viewports")
	check_eq(len(mock_fail["provider_errors"]) > 0, true, "provider: fail has errors")
}

# ============================================================
# Error-path coverage (Task 0.5)
# ============================================================

func test_provider_failed_error_flag() {
	# Explicit hard-error flag is a total failure.
	check_eq(provider_failed({"error": true, "viewports": array()}), true, "provider_failed: error flag → true")
}

func test_provider_failed_no_viewports_key() {
	# Missing viewports key entirely → nothing to report on.
	check_eq(provider_failed({"url": "http://test"}), true, "provider_failed: no viewports key → true")
}

func test_provider_failed_empty_viewports() {
	check_eq(provider_failed({"viewports": array()}), true, "provider_failed: empty viewports → true")
}

func test_provider_failed_all_nav_errors() {
	# Every viewport failed to navigate AND produced no usable data.
	res := {
		"viewports": array(
			{"name": "desktop", "navigation_error": "net::ERR"},
			{"name": "mobile", "navigation_error": "net::ERR"}
		)
	}
	check_eq(provider_failed(res), true, "provider_failed: all nav errors, no data → true")
}

func test_provider_failed_partial_usable() {
	# One viewport failed but another produced a DOM summary → NOT total failure.
	res := {
		"viewports": array(
			{"name": "desktop", "navigation_error": "net::ERR"},
			{"name": "mobile", "dom_summary": {"title": "ok"}}
		)
	}
	check_eq(provider_failed(res), false, "provider_failed: partial usable data → false")
}

func test_provider_failed_clean_navigation() {
	# A viewport with no navigation_error is usable even without dom/screenshot.
	res := { "viewports": array({"name": "desktop"}) }
	check_eq(provider_failed(res), false, "provider_failed: clean navigation → false")
}

func test_redacted_bridge_command_for_display() {
	cmd := redacted_bridge_command_for_display(array(
		"node",
		"bridge/browser-bridge.js",
		"--url",
		"http://localhost:3000/?token=SUPERSECRET&api_key=KEYVALUE123456",
		"--auth-file",
		"/Users/example/private/state.json",
		"--format",
		"json"
	))
	check(is_falseish(contains(cmd, "SUPERSECRET")), "provider verbose: URL token redacted")
	check(is_falseish(contains(cmd, "KEYVALUE123456")), "provider verbose: API key redacted")
	check(is_falseish(contains(cmd, "/Users/example/private/state.json")), "provider verbose: auth file path redacted")
	check(is_trueish(contains(cmd, "--auth-file [REDACTED]")), "provider verbose: auth file flag retained with redaction marker")
}

func test_parse_timeout_clamp_high() {
	argv := array("check", "--timeout", "9999", "http://localhost:3000")
	check_eq(parse_timeout(argv), 300, "parse_timeout: clamps above 300")
}

func test_parse_timeout_clamp_low() {
	argv := array("check", "--timeout", "0", "http://localhost:3000")
	check_eq(parse_timeout(argv), 30, "parse_timeout: invalid low falls back to default")
}

func test_parse_max_links_clamp_high() {
	argv := array("check", "--max-links", "9999", "http://localhost:3000")
	check_eq(parse_max_links(argv), 500, "parse_max_links: clamps above 500")
}

func test_severity_index_invalid() {
	check_eq(severity_index("bogus"), -1, "severity_index: unknown severity → -1")
}

func test_severity_meets_threshold_edges() {
	check_eq(severity_meets_threshold("info", "critical"), false, "threshold: info does not meet critical")
	check_eq(severity_meets_threshold("critical", "info"), true, "threshold: critical meets info")
	check_eq(severity_meets_threshold("error", "error"), true, "threshold: equal severities meet")
}

