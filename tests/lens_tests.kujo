func test_is_accessibility_flag() {
	argv := array("check", "--accessibility", "http://localhost:3000")
	check(is_accessibility(argv) == true, "is_accessibility detects --accessibility flag")
	
	argv2 := array("check", "--a11y", "http://localhost:3000")
	check(is_accessibility(argv2) == true, "is_accessibility detects --a11y alias")
	
	argv3 := array("check", "http://localhost:3000")
	check(is_accessibility(argv3) == false, "is_accessibility returns false when no a11y flags")
}

func test_parse_a11y_tags_default() {
	argv := array("check", "http://localhost:3000")
	tags := parse_a11y_tags(argv)
	check(len(tags) > 0, "parse_a11y_tags returns default tags when flag not set")
	check_eq(tags[0], "wcag2a", "parse_a11y_tags default includes wcag2a")
}

func test_parse_a11y_tags_custom() {
	argv := array("check", "--a11y-tags", "wcag2aa,wcag21a", "http://localhost:3000")
	tags := parse_a11y_tags(argv)
	check(len(tags) == 2, "parse_a11y_tags splits comma-separated tags")
}

func test_parse_a11y_tags_single() {
	argv := array("check", "--a11y-tags", "best-practice", "http://localhost:3000")
	tags := parse_a11y_tags(argv)
	check(len(tags) == 1, "parse_a11y_tags handles single tag (no comma)")
	check_eq(tags[0], "best-practice", "parse_a11y_tags returns the single tag")
}

func test_parse_a11y_include() {
	argv := array("check", "--a11y-include", "main", "http://localhost:3000")
	val := parse_a11y_include(argv)
	check_eq(val, "main", "parse_a11y_include returns selector")
}

func test_parse_a11y_exclude() {
	argv := array("check", "--a11y-exclude", "[data-testid='widget']", "http://localhost:3000")
	val := parse_a11y_exclude(argv)
	check_eq(val, "[data-testid='widget']", "parse_a11y_exclude returns selector")
}

func test_map_a11y_severity_critical() {
	check_eq(map_a11y_severity("critical"), "error", "critical impact maps to error")
}

func test_map_a11y_severity_serious() {
	check_eq(map_a11y_severity("serious"), "error", "serious impact maps to error")
}

func test_map_a11y_severity_moderate() {
	check_eq(map_a11y_severity("moderate"), "warning", "moderate impact maps to warning")
}

func test_map_a11y_severity_minor() {
	check_eq(map_a11y_severity("minor"), "info", "minor impact maps to info")
}

func test_map_a11y_severity_unknown() {
	check_eq(map_a11y_severity("unknown"), "warning", "unknown impact maps to warning (safe default)")
}

func test_is_a11y_enabled_default() {
	config := {
		"url": "http://localhost:3000"
	}
	check(is_a11y_enabled(config) == false, "is_a11y_enabled returns false when accessibility not in config")
}

func test_is_a11y_enabled_true() {
	config := {
		"url": "http://localhost:3000",
		"accessibility": true
	}
	check(is_a11y_enabled(config) == true, "is_a11y_enabled returns true when accessibility is true")
}

func test_is_a11y_enabled_false() {
	config := {
		"url": "http://localhost:3000",
		"accessibility": false
	}
	check(is_a11y_enabled(config) == false, "is_a11y_enabled returns false when accessibility is false")
}

func test_build_config_a11y_defaults() {
	argv := array("check", "http://localhost:3000")
	config := build_config(argv)
	check(config["accessibility"] == false, "build_config defaults accessibility to false")
	check(len(config["a11y_tags"]) > 0, "build_config sets default a11y_tags")
	check_eq(config["a11y_include"], "", "build_config defaults a11y_include to empty")
	check_eq(config["a11y_exclude"], "", "build_config defaults a11y_exclude to empty")
}

func test_build_config_a11y_enabled() {
	argv := array("check", "--accessibility", "http://localhost:3000")
	config := build_config(argv)
	check(config["accessibility"] == true, "build_config enables accessibility with flag")
}

# ============================================================
# Enterprise Hardening Tests
