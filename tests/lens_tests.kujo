# Exit code constants (must be defined locally; Kujo from-import
# does not support top-level := bindings, only exported functions).
EXIT_OK := 0
EXIT_CHECK_FAIL := 1
EXIT_INVALID_INPUT := 2
EXIT_BROWSER_FAIL := 3
EXIT_ARTIFACT_FAIL := 4

mut passed := 0
mut failed := 0

func check(cond, name) {
	if cond == true {
		passed = passed + 1
	} else {
		failed = failed + 1
		print("  FAIL: " + name)
	}
}

func check_eq(actual, expected, name) {
	if to_string(actual) == to_string(expected) {
		passed = passed + 1
	} else {
		failed = failed + 1
		print("  FAIL: " + name + " (expected " + to_string(expected) + ", got " + to_string(actual) + ")")
	}
}

func check_neq(actual, unexpected, name) {
	if to_string(actual) != to_string(unexpected) {
		passed = passed + 1
	} else {
		failed = failed + 1
		print("  FAIL: " + name + " (should not equal " + to_string(unexpected) + ")")
	}
}

# ============================================================
# CLI Argument Parsing Tests
# ============================================================

func test_subcommand_parsing() {
	check_eq(parse_subcommand(array("check", "http://localhost:3000")), "check", "parse_subcommand returns 'check'")
	check_eq(parse_subcommand(array("summarize")), "summarize", "parse_subcommand returns arbitrary command")
	check_eq(parse_subcommand(array("--help")), "", "parse_subcommand returns empty for flag-only args")
	check_eq(parse_subcommand(array()), "", "parse_subcommand returns empty for no args")
}

func test_has_flag() {
	argv := array("check", "--verbose", "http://localhost:3000")
	check(has_flag(argv, "--verbose") == true, "has_flag detects present flag")
	check(has_flag(argv, "--json") == false, "has_flag returns false for missing flag")
}

func test_flag_value() {
	argv := array("check", "--out", "/tmp/lens-test", "http://localhost:3000")
	check_eq(flag_value(argv, "--out", ""), "/tmp/lens-test", "flag_value returns flag value")
	check_eq(flag_value(argv, "--timeout", "30"), "30", "flag_value returns default when missing")
}

func test_build_config_defaults() {
	argv := array("check", "http://localhost:3000")
	config := build_config(argv)
	check_eq(config["url"], "http://localhost:3000", "build_config extracts URL")
	check_eq(config["timeout"], 30, "build_config has default timeout")
	check_eq(config["fail_on"], "error", "build_config has default fail_on")
	check(config["allow_external"] == false, "build_config defaults to no external")
	check(config["check_links"] == false, "build_config defaults to no link check")
	check(config["json_output"] == false, "build_config defaults to no json output")
	check(config["verbose"] == false, "build_config defaults to non-verbose")
}

func test_build_config_flags() {
	argv := array("check", "--allow-external", "--check-links", "--json", "--verbose", "--timeout", "60", "--fail-on", "warning", "https://example.com")
	config := build_config(argv)
	check_eq(config["url"], "https://example.com", "build_config extracts URL with flags")
	check_eq(config["timeout"], 60, "build_config parses --timeout")
	check_eq(config["fail_on"], "warning", "build_config parses --fail-on")
	check(config["allow_external"] == true, "build_config detects --allow-external")
	check(config["check_links"] == true, "build_config detects --check-links")
	check(config["json_output"] == true, "build_config detects --json")
	check(config["verbose"] == true, "build_config detects --verbose")
}

func test_quick_profile_defaults() {
	argv := array("check", "--quick", "http://localhost:3000")
	config := build_config(argv)
	check_eq(is_quick(argv), true, "quick: flag is detected")
	check_eq(config["quick"], true, "quick: profile recorded in config")
	check_eq(config["json_output"], true, "quick: JSON output enabled")
	check_eq(len(config["viewports"]), 1, "quick: one viewport selected")
	check_eq(config["viewports"][0], "desktop", "quick: desktop viewport selected")
	check_eq(config["settle_ms"], 0, "quick: extra settle disabled")
	check_eq(config["browser"], "chromium", "quick: optimized Chromium selected")
}

func test_quick_profile_explicit_overrides() {
	argv := array("check", "--quick", "--viewport", "mobile", "--settle-ms", "250", "--browser", "firefox", "http://localhost:3000")
	config := build_config(argv)
	check_eq(config["viewports"][0], "mobile", "quick: explicit viewport wins")
	check_eq(config["settle_ms"], 250, "quick: explicit settle window wins")
	check_eq(config["browser"], "firefox", "quick: explicit browser wins")
}

# ============================================================
# URL Validation Tests
# ============================================================

func test_extract_host() {
	check_eq(extract_host("http://localhost:3000"), "localhost", "extract_host: localhost with port")
	check_eq(extract_host("https://127.0.0.1:8080/path"), "127.0.0.1", "extract_host: 127.0.0.1 with path")
	check_eq(extract_host("http://[::1]:3000"), "[::1]", "extract_host: [::1] with port")
	check_eq(extract_host("https://example.com"), "example.com", "extract_host: external host")
	check_eq(extract_host("https://example.com/path?q=1"), "example.com", "extract_host: external with path and query")
}

func test_has_valid_scheme() {
	check(has_valid_scheme("http://localhost:3000") == true, "valid_scheme: http")
	check(has_valid_scheme("https://example.com") == true, "valid_scheme: https")
	check(has_valid_scheme("ftp://example.com") == false, "valid_scheme: ftp not allowed")
	check(has_valid_scheme("localhost:3000") == false, "valid_scheme: no scheme")
}

func test_is_localhost_host() {
	check(is_localhost_host("localhost") == true, "is_localhost_host: localhost")
	check(is_localhost_host("127.0.0.1") == true, "is_localhost_host: 127.0.0.1")
	check(is_localhost_host("[::1]") == true, "is_localhost_host: [::1]")
	check(is_localhost_host("example.com") == false, "is_localhost_host: external host")
}

func test_is_localhost_url() {
	check(is_localhost_url("http://localhost:3000") == true, "is_localhost_url: localhost ok")
	check(is_localhost_url("http://127.0.0.1:8080") == true, "is_localhost_url: 127.0.0.1 ok")
	check(is_localhost_url("http://[::1]:3000") == true, "is_localhost_url: ::1 ok")
	check(is_localhost_url("https://example.com") == false, "is_localhost_url: external not localhost")
}

func test_validate_url_localhost_allowed() {
	result := validate_url("http://localhost:3000", false)
	check(result["valid"] == true, "validate_url: localhost allowed by default")
	check_eq(result["error"], "", "validate_url: no error for localhost")
}

func test_validate_url_127_allowed() {
	result := validate_url("http://127.0.0.1:8080", false)
	check(result["valid"] == true, "validate_url: 127.0.0.1 allowed by default")
}

func test_validate_url_ipv6_allowed() {
	result := validate_url("http://[::1]:3000", false)
	check(result["valid"] == true, "validate_url: ::1 allowed by default")
}

func test_validate_url_external_blocked() {
	result := validate_url("https://example.com", false)
	check(result["valid"] == false, "validate_url: external URL blocked by default")
	check(result["error"] != "", "validate_url: error message for blocked external")
}

func test_validate_url_external_allowed_with_flag() {
	result := validate_url("https://example.com", true)
	check(result["valid"] == true, "validate_url: external URL allowed with --allow-external")
}

func test_validate_url_empty() {
	result := validate_url("", false)
	check(result["valid"] == false, "validate_url: empty URL rejected")
}

func test_validate_url_invalid_scheme() {
	result := validate_url("ftp://example.com", false)
	check(result["valid"] == false, "validate_url: invalid scheme rejected")
}

# ============================================================
# Viewport Parsing Tests
