func print_summary() {
	total := passed + failed
	print("")
	print("=== Lens Test Results ===")
	print("Passed: " + to_string(passed))
	print("Failed: " + to_string(failed))
	print("Total:  " + to_string(total))
	print("")
	if failed == 0 {
		print("All tests passed.")
	} else {
		print("Some tests FAILED.")
	}
}

