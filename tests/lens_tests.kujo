func test_check_performance_flags_slow_lcp() {
	config := { "perf_lcp_ms": 2000, "perf_cls_x100": 25, "perf_ttfb_ms": 1500 }
	bridge_data := { "metrics": array({ "viewport": "desktop", "lcp_ms": 5000, "ttfb_ms": 100, "cls": 0.01 }) }
	cr := check_performance(config, bridge_data)
	check(len(cr["findings"]) >= 1, "perf check: flags slow LCP")
	check_eq(to_string(cr["findings"][0]["severity"]), "warning", "perf check: LCP finding is warning")
}

func test_check_performance_clean_within_thresholds() {
	config := { "perf_lcp_ms": 4000, "perf_cls_x100": 25, "perf_ttfb_ms": 1500 }
	bridge_data := { "metrics": array({ "viewport": "desktop", "lcp_ms": 800, "ttfb_ms": 100, "cls": 0.01 }) }
	cr := check_performance(config, bridge_data)
	check_eq(len(cr["findings"]), 0, "perf check: no findings when within thresholds")
}

func test_check_performance_no_metrics() {
	cr := check_performance({ "perf_lcp_ms": 4000 }, { "dom_summaries": array() })
	check_eq(len(cr["findings"]), 0, "perf check: no metrics → no findings")
}

