func test_is_digits() {
	check_eq(is_digits("123"), true, "is_digits: 123 → true")
	check_eq(is_digits(""), false, "is_digits: empty → false")
	check_eq(is_digits("12a"), false, "is_digits: 12a → false")
	check_eq(is_digits("x"), false, "is_digits: x → false")
}

func test_is_size_token() {
	check_eq(is_size_token("1024x768"), true, "is_size_token: 1024x768 → true")
	check_eq(is_size_token("800X600"), true, "is_size_token: case-insensitive X")
	check_eq(is_size_token("desktop"), false, "is_size_token: desktop → false")
	check_eq(is_size_token("x900"), false, "is_size_token: missing width → false")
	check_eq(is_size_token("1024x"), false, "is_size_token: missing height → false")
	check_eq(is_size_token("0x0"), false, "is_size_token: zero dims → false")
}

func test_parse_viewport_custom() {
	check_eq(parse_viewport("desktop"), "desktop", "parse_viewport: preset desktop")
	check_eq(parse_viewport("1024x768"), "1024x768", "parse_viewport: custom size")
	check_eq(parse_viewport("768X1024"), "768x1024", "parse_viewport: normalizes case")
	check_eq(parse_viewport("garbage"), "", "parse_viewport: invalid → empty")
}

func test_parse_settle_ms() {
	check_eq(parse_settle_ms(array("check", "http://localhost:3000")), 400, "settle_ms: default 400")
	check_eq(parse_settle_ms(array("check", "--settle-ms", "100", "http://localhost:3000")), 100, "settle_ms: custom 100")
	check_eq(parse_settle_ms(array("check", "--settle-ms", "999999", "http://localhost:3000")), 10000, "settle_ms: clamps high")
	check_eq(parse_settle_ms(array("check", "--settle-ms", "0", "http://localhost:3000")), 0, "settle_ms: 0 allowed")
}

func test_parse_max_concurrency() {
	check_eq(parse_max_concurrency(array("check", "http://localhost:3000")), 0, "max_concurrency: default 0")
	check_eq(parse_max_concurrency(array("check", "--max-concurrency", "2", "http://localhost:3000")), 2, "max_concurrency: custom 2")
	check_eq(parse_max_concurrency(array("check", "--max-concurrency", "99", "http://localhost:3000")), 16, "max_concurrency: clamps high")
}

func test_parse_config_path() {
	check_eq(parse_config_path(array("check", "http://localhost:3000")), "", "config_path: default empty")
	check_eq(parse_config_path(array("check", "--config", "my.toml", "http://localhost:3000")), "my.toml", "config_path: custom")
}

func test_resolve_config_path() {
	implicit := resolve_config_path(array("check", "http://localhost:3000"))
	check_eq(implicit["path"], ".lens.toml", "resolve_config: implicit default name")
	check_eq(implicit["explicit"], false, "resolve_config: implicit not explicit")
	explicit := resolve_config_path(array("check", "--config", "team.toml", "http://localhost:3000"))
	check_eq(explicit["path"], "team.toml", "resolve_config: explicit path")
	check_eq(explicit["explicit"], true, "resolve_config: explicit flag set")
}

func test_load_config_file_missing_implicit() {
	# Implicit, non-existent file → valid, not present, no error.
	res := load_config_file("/tmp/lens-nonexistent-xyz.toml", false)
	check_eq(res["valid"], true, "load_config: implicit missing → valid")
	check_eq(res["present"], false, "load_config: implicit missing → not present")
}

func test_load_config_file_missing_explicit() {
	# Explicit, non-existent file → invalid (hard error).
	res := load_config_file("/tmp/lens-nonexistent-xyz.toml", true)
	check_eq(res["valid"], false, "load_config: explicit missing → invalid")
}

func test_load_config_file_valid() {
	path := "/tmp/lens-test-config.toml"
	write_file(path, "fail_on = \"warning\"\ntimeout = 45\ncheck_links = true\n", true)
	res := load_config_file(path, true)
	check_eq(res["valid"], true, "load_config: valid file → valid")
	check_eq(res["present"], true, "load_config: valid file → present")
	data := res["data"]
	check_eq(to_string(data["fail_on"]), "warning", "load_config: reads fail_on")
	check_eq(to_string(data["timeout"]), "45", "load_config: reads timeout")
}

func test_load_config_file_invalid_toml() {
	path := "/tmp/lens-test-bad-config.toml"
	write_file(path, "this is = = not valid [[[", true)
	res := load_config_file(path, true)
	check_eq(res["valid"], false, "load_config: malformed TOML → invalid (caught)")
}

func test_merge_file_config_applies_when_flag_absent() {
	config := build_config(array("check", "http://localhost:3000"))
	file_data := { "fail_on": "warning", "timeout": 99, "check_links": true }
	merged := merge_file_config(config, array("check", "http://localhost:3000"), file_data)
	check_eq(to_string(merged["fail_on"]), "warning", "merge: file fail_on applied")
	check_eq(to_string(merged["timeout"]), "99", "merge: file timeout applied")
	check_eq(merged["check_links"], true, "merge: file check_links applied")
}

func test_merge_file_config_cli_wins() {
	argv := array("check", "--fail-on", "critical", "http://localhost:3000")
	config := build_config(argv)
	file_data := { "fail_on": "warning" }
	merged := merge_file_config(config, argv, file_data)
	check_eq(to_string(merged["fail_on"]), "critical", "merge: CLI flag overrides file")
}

func test_merge_file_config_invalid_fail_on() {
	config := build_config(array("check", "http://localhost:3000"))
	file_data := { "fail_on": "bogus" }
	merged := merge_file_config(config, array("check", "http://localhost:3000"), file_data)
	check_eq(to_string(merged["fail_on"]), "error", "merge: invalid file fail_on falls back to default")
}

func test_merge_file_config_viewports() {
	config := build_config(array("check", "http://localhost:3000"))
	file_data := { "viewports": array("desktop", "1024x768", "garbage") }
	merged := merge_file_config(config, array("check", "http://localhost:3000"), file_data)
	vps := merged["viewports"]
	check_eq(len(vps), 2, "merge: viewports validated (garbage dropped)")
	check_eq(to_string(vps[1]), "1024x768", "merge: custom viewport kept")
}

func test_quick_profile_overrides_project_defaults() {
	argv := array("check", "--quick", "http://localhost:3000")
	config := build_config(argv)
	file_data := { "viewports": array("desktop", "mobile"), "settle_ms": 900, "browser": "webkit" }
	merged := merge_file_config(config, argv, file_data)
	check_eq(len(merged["viewports"]), 1, "quick merge: project viewports stay compact")
	check_eq(merged["viewports"][0], "desktop", "quick merge: desktop remains selected")
	check_eq(merged["settle_ms"], 0, "quick merge: project settle does not slow profile")
	check_eq(merged["browser"], "chromium", "quick merge: project browser does not replace optimized default")
}

