func test_phase4_flags() {
	check_eq(is_execute(array("flow", "f.json")), false, "execute: default off")
	check_eq(is_execute(array("flow", "--execute", "f.json")), true, "execute: enabled")
	check_eq(is_record(array("flow", "--record", "f.json")), true, "record: enabled")
	check_eq(is_walkthrough(array("flow", "--walkthrough", "f.json")), true, "walkthrough: enabled")
}

func test_lens_version_consistent() {
	check_eq(lens_version(), "1.0.0", "lens_version: single source is 1.0.0")
	check_eq(LENS_VERSION, "1.0.0", "test-local LENS_VERSION matches")
}

func test_flow_step_cap() {
	# Build a flow with 201 visit steps → should be rejected by the cap.
	mut steps := "["
	mut i := 0
	while i < 201 {
		if i > 0 { steps = steps + "," }
		steps = steps + "{\"visit\":\"http://localhost:3000/\"}"
		i = i + 1
	}
	steps = steps + "]"
	path := "/tmp/lens-bigflow.json"
	write_file(path, "{\"name\":\"big\",\"url\":\"http://localhost:3000/\",\"steps\":" + steps + "}", true)
	res := load_flow_file(path)
	check_eq(res["valid"], false, "flow cap: 201 steps rejected")
	check(is_trueish(contains(to_string(res["error"]), "too many steps")), "flow cap: clear error message")
}

func test_flow_normal_loads() {
	path := "/tmp/lens-okflow.json"
	write_file(path, "{\"name\":\"ok\",\"url\":\"http://localhost:3000/\",\"steps\":[{\"visit\":\"http://localhost:3000/\"}]}", true)
	res := load_flow_file(path)
	check_eq(res["valid"], true, "flow cap: normal flow still loads")
}

# ============================================================
# Flow safety model + validation field checks
# ============================================================

func test_is_destructive() {
	check_eq(is_destructive("delete-account"), true, "is_destructive: delete → true")
	check_eq(is_destructive("/admin/logout"), true, "is_destructive: logout → true")
	check_eq(is_destructive("Cancel Subscription"), true, "is_destructive: cancel subscription → true")
	check_eq(is_destructive("#save-btn"), false, "is_destructive: save → false")
	check_eq(is_destructive("Next"), false, "is_destructive: Next → false")
	check_eq(is_destructive("#email"), false, "is_destructive: email → false")
}

func test_check_click_safety_requires_safe() {
	r := check_click_safety({ "selector": "#go" }, { "allow_destructive": false })
	check_eq(r["allowed"], false, "click safety: missing safe:true → blocked")
}

func test_check_click_safety_allows_safe() {
	r := check_click_safety({ "selector": "#go", "safe": true }, { "allow_destructive": false })
	check_eq(r["allowed"], true, "click safety: safe non-destructive → allowed")
}

func test_check_click_safety_blocks_destructive() {
	r := check_click_safety({ "selector": "#delete-account", "safe": true }, { "allow_destructive": false })
	check_eq(r["allowed"], false, "click safety: destructive without opt-in → blocked")
}

func test_check_click_safety_destructive_optin() {
	r := check_click_safety({ "selector": "#delete-account", "safe": true, "destructive": true }, { "allow_destructive": true })
	check_eq(r["allowed"], true, "click safety: destructive with both opt-ins → allowed")
}

func test_check_type_safety_secret_field() {
	r := check_type_safety({ "selector": "#password", "value": "x" })
	check_eq(r["allowed"], false, "type safety: password field without secret:true → blocked")
	r2 := check_type_safety({ "selector": "#password", "value": "x", "secret": true })
	check_eq(r2["allowed"], true, "type safety: password field with secret:true → allowed")
	r3 := check_type_safety({ "selector": "#email", "value": "a@b.com" })
	check_eq(r3["allowed"], true, "type safety: normal field → allowed")
}

func test_step_required_field_error() {
	check_eq(step_required_field_error({ "visit": "" }, "visit") != "", true, "field: visit missing url")
	check_eq(step_required_field_error({ "visit": "http://localhost" }, "visit"), "", "field: visit ok")
	check_eq(step_required_field_error({ "click": { "selector": "" } }, "click"), "missing selector", "field: click missing selector")
	check_eq(step_required_field_error({ "click": { "selector": "#x" } }, "click"), "", "field: click ok")
	check_eq(step_required_field_error({ "type": {} }, "type"), "missing selector", "field: type missing selector")
	check_eq(step_required_field_error({ "scroll": {} }, "scroll"), "missing selector or y", "field: scroll missing both")
	check_eq(step_required_field_error({ "scroll": { "y": 100 } }, "scroll"), "", "field: scroll with y ok")
	check_eq(step_required_field_error({ "assert_selector": "" }, "assert_selector"), "missing selector", "field: assert_selector missing")
	check_eq(step_required_field_error({ "assert_text": "" }, "assert_text"), "missing text", "field: assert_text missing")
	check_eq(step_required_field_error({ "screenshot": { "name": "x" } }, "screenshot"), "", "field: screenshot has no required field")
}

func test_redact_flow_for_output() {
	flow := {
		"name": "Login",
		"steps": array(
			{ "visit": "http://localhost:3000/" },
			{ "type": { "selector": "#pw", "value": "SUPERSECRETPW42", "secret": true } }
		)
	}
	red := redact_flow_for_output(flow)
	red_json := to_json(red)
	check(is_falseish(contains(red_json, "SUPERSECRETPW42")), "flow redact: typed secret removed")
	check(is_trueish(contains(red_json, "[REDACTED]")), "flow redact: placeholder present")
	# Structure preserved.
	check_eq(len(red["steps"]), 2, "flow redact: step count preserved")
}

func test_build_program_step_click() {
	step := { "click": { "selector": "#go", "safe": true } }
	ps := build_program_step(step, 3)
	check_eq(to_string(ps["type"]), "click", "program step: click type")
	check_eq(to_string(ps["index"]), "3", "program step: index preserved")
	check_eq(to_string(ps["selector"]), "#go", "program step: selector extracted")
}

func test_build_program_step_type_carries_value() {
	step := { "type": { "selector": "#q", "value": "hello" } }
	ps := build_program_step(step, 1)
	check_eq(to_string(ps["selector"]), "#q", "program step: type selector")
	check_eq(to_string(ps["value"]), "hello", "program step: type value")
}

func test_build_program_step_non_executable_is_null() {
	# console/network assertions are evaluated in Kujo, not sent to the bridge.
	step := { "assert_no_console_errors": true }
	ps := build_program_step(step, 1)
	check_eq(ps, null, "program step: console assert → null (not executable)")
}

func test_generate_walkthrough_html() {
	flow := { "name": "Login flow" }
	meta := { "status": "PASS", "started_at": "t0", "finished_at": "t1", "duration_ms": 2500 }
	steps := array(
		{ "index": 1, "type": "visit", "status": "pass", "error": "Navigated" },
		{ "index": 2, "type": "click", "status": "pass", "error": "Clicked #go" }
	)
	html := generate_walkthrough_html(flow, meta, steps, "video/walkthrough.webm", 2, 0, 0, 0)
	check(is_trueish(contains(html, "<!doctype html>")), "walkthrough: doctype")
	check(is_trueish(contains(html, "Login flow")), "walkthrough: flow name")
	check(is_trueish(contains(html, "<video")), "walkthrough: embeds video")
	check(is_trueish(contains(html, "walkthrough.webm")), "walkthrough: video src")
	check(is_trueish(contains(html, "lens-")), "walkthrough: fingerprint present")
}

func test_write_ledger_record_appends() {
	path := "/tmp/lens-test-ledger.jsonl"
	if is_trueish(file_exists(path)) { delete_file(path) }
	counts := { "critical": 0, "error": 1, "warning": 0, "info": 2 }
	write_ledger_record(path, "0.7.0", "http://localhost:3000", "FAIL", 1, "t0", "t1", 1234, counts)
	write_ledger_record(path, "0.7.0", "http://localhost:3000", "PASS", 0, "t2", "t3", 1000, { "critical": 0, "error": 0, "warning": 0, "info": 0 })
	content := read_file(path)
	# Two JSONL lines (two trailing newlines → splitting yields content).
	check(is_trueish(contains(content, "FAIL")), "ledger: first record present")
	check(is_trueish(contains(content, "PASS")), "ledger: second record appended")
	check(is_trueish(contains(content, "schema_version")), "ledger: schema field present")
}

func test_write_howl_summary() {
	path := "/tmp/lens-test-howl.json"
	if is_trueish(file_exists(path)) { delete_file(path) }
	write_howl_summary(path, "0.7.0", "http://localhost:3000", "PASS", 0, 900, { "critical": 0, "error": 0, "warning": 0, "info": 0 }, "/x/report.md")
	content := read_file(path)
	check(is_trueish(contains(content, "PASS")), "howl: status present")
	check(is_trueish(contains(content, "headline")), "howl: headline present")
}

func test_collect_crawl_candidates() {
	base := "http://localhost:3000"
	provider_result := {
		"viewports": array({
			"name": "desktop",
			"links": array(
				{ "href": "/about", "text": "About", "title": "", "aria_label": "" },
				{ "href": "http://localhost:3000/contact", "text": "Contact", "title": "", "aria_label": "" },
				{ "href": "https://external.example.com/x", "text": "Ext", "title": "", "aria_label": "" },
				{ "href": "mailto:hi@x.com", "text": "Mail", "title": "", "aria_label": "" },
				{ "href": "/admin/delete", "text": "Del", "title": "", "aria_label": "" }
			)
		})
	}
	cands := collect_crawl_candidates(provider_result, base)
	# Only /about and /contact are safe same-origin; external/mailto/destructive dropped.
	check_eq(len(cands), 2, "crawl candidates: keeps 2 safe same-origin links")
}

func test_malformed_flow_json_is_rejected() {
	path := "/tmp/lens-test-malformed-flow.json"
	write_file(path, "{\"name\": \"broken\", \"steps\": [}", true)
	result := load_flow_file(path)
	check_eq(result["valid"], false, "flow loader: malformed JSON is rejected without crashing")
	check(is_trueish(contains(to_string(result["error"]), "Invalid JSON")), "flow loader: malformed JSON explains the error")
}

func test_malformed_spec_json_is_rejected() {
	path := "/tmp/lens-test-malformed-spec.json"
	write_file(path, "{\"title\": {\"contains\": }}", true)
	result := load_spec_file(path)
	check_eq(result["valid"], false, "spec loader: malformed JSON is rejected without crashing")
	check(is_trueish(contains(to_string(result["error"]), "Invalid JSON")), "spec loader: malformed JSON explains the error")
}

func test_normalize_url_resolves_document_relative_links() {
	base := "http://localhost:3000/docs/page.html?old=1#top"
	check_eq(normalize_url("next.html", base), "http://localhost:3000/docs/next.html", "normalize_url: relative link resolves against document directory")
	check_eq(normalize_url("?new=2", base), "http://localhost:3000/docs/page.html?new=2", "normalize_url: query-relative link replaces current query")
	check_eq(normalize_url("about", "http://localhost:3000"), "http://localhost:3000/about", "normalize_url: relative link resolves from an origin-only base")
}

func test_normalize_url_preserves_protocol_relative_origin() {
	check_eq(normalize_url("//example.com/path", "https://localhost:3000/app"), "https://example.com/path", "normalize_url: protocol-relative external link remains external")
}

func test_prepare_link_url_keeps_request_secret_and_redacts_display() {
	prepared := prepare_link_url("/download?token=secret-value", "http://localhost:3000/app")
	check(is_trueish(contains(to_string(prepared["request_url"]), "secret-value")), "link URL: real request retains required query value")
	check(is_falseish(contains(to_string(prepared["display_url"]), "secret-value")), "link URL: stored display URL redacts query value")
}

func test_duplicate_link_urls_are_detected() {
	seen := array("http://localhost:3000/about")
	check_eq(link_url_was_seen(seen, "http://localhost:3000/about"), true, "link check: duplicate viewport URL is detected")
	check_eq(link_url_was_seen(seen, "http://localhost:3000/contact"), false, "link check: unique URL is not skipped")
}

func test_console_artifact_writing() {
	# Verify console messages serialize to valid JSON-like array.
	messages := array(
		{
			"type": "error",
			"text": "Test error",
			"timestamp": "2026-01-01T00:00:00Z",
			"viewport": "desktop"
		}
	)
	json_str := to_json(messages)
	check(json_str != "", "console: serializes to non-empty JSON")
	check(is_trueish(contains(json_str, "Test error")), "console: contains message text")
}

func test_network_artifact_writing() {
	# Verify network events serialize correctly.
	events := array(
		{
			"url": "http://test/404",
			"method": "GET",
			"status": 404,
			"resource_type": "document",
			"timestamp": "2026-01-01T00:00:00Z",
			"viewport": "desktop"
		}
	)
	json_str := to_json(events)
	check(json_str != "", "network: serializes to non-empty JSON")
	check(is_trueish(contains(json_str, "404")), "network: contains status code")
}

func test_dom_summary_artifact_writing() {
	summaries := array(
		{
			"viewport": "desktop",
			"url": "http://test",
			"title": "Test Page",
			"body_text_length": 100,
			"link_count": 5
		}
	)
	json_str := to_json(summaries)
	check(json_str != "", "dom: serializes to non-empty JSON")
	check(is_trueish(contains(json_str, "Test Page")), "dom: contains title")
}

func test_report_references_runtime_artifacts() {
	# Verify report mentions new artifacts.
	config := {
		"url": "http://localhost:3000",
		"viewports": array("desktop"),
		"version": LENS_VERSION
	}
	meta := {
		"status": "PASS",
		"started_at": "2026-01-01T00:00:00Z",
		"finished_at": "2026-01-01T00:00:01Z",
		"duration_ms": 1000,
		"out_dir": ".lens/runs/test",
		"exit_code": 0,
		"artifacts": array("console.json", "network.json", "dom-summary.json")
	}
	cr := new_check_result("Test", "test")
	cr = add_finding(cr, new_finding("info", "TEST", "Info", "Test", "", ""))
	check_results := array(cr)
	
	report := generate_markdown_report(config, meta, check_results)
	check(is_trueish(contains(report, "console.json")), "report: mentions console.json")
	check(is_trueish(contains(report, "network.json")), "report: mentions network.json")
	check(is_trueish(contains(report, "dom-summary.json")), "report: mentions dom-summary.json")
	check(is_trueish(contains(report, "screenshots")), "report: mentions screenshots")
}

