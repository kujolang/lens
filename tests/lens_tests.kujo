func test_parse_viewport() {
	check_eq(parse_viewport("desktop"), "desktop", "parse_viewport: desktop")
	check_eq(parse_viewport("mobile"), "mobile", "parse_viewport: mobile")
	check_eq(parse_viewport("DESKTOP"), "desktop", "parse_viewport: case insensitive")
	check_eq(parse_viewport("tablet"), "", "parse_viewport: invalid returns empty")
	check_eq(parse_viewport(""), "", "parse_viewport: empty returns empty")
}

func test_parse_viewports_default() {
	argv := array("check", "http://localhost:3000")
	vps := parse_viewports(argv)
	check(len(vps) == 2, "parse_viewports: defaults to 2 viewports")
}

func test_parse_viewports_single() {
	argv := array("check", "--viewport", "mobile", "http://localhost:3000")
	vps := parse_viewports(argv)
	check(len(vps) == 1, "parse_viewports: single viewport specified")
	check_eq(vps[0], "mobile", "parse_viewports: correct viewport")
}

# ============================================================
# Severity Tests
# ============================================================

func test_parse_severity() {
	check_eq(parse_severity("info"), "info", "parse_severity: info")
	check_eq(parse_severity("warning"), "warning", "parse_severity: warning")
	check_eq(parse_severity("error"), "error", "parse_severity: error")
	check_eq(parse_severity("critical"), "critical", "parse_severity: critical")
	check_eq(parse_severity("WARNING"), "warning", "parse_severity: case insensitive")
	check_eq(parse_severity("unknown"), "", "parse_severity: invalid returns empty")
}

func test_severity_index() {
	check(severity_index("info") < severity_index("warning"), "severity_index: info < warning")
	check(severity_index("warning") < severity_index("error"), "severity_index: warning < error")
	check(severity_index("error") < severity_index("critical"), "severity_index: error < critical")
	check_eq(severity_index("unknown"), -1, "severity_index: invalid returns -1")
}

func test_severity_meets_threshold() {
	check(severity_meets_threshold("error", "error") == true, "severity_meets: error meets error")
	check(severity_meets_threshold("critical", "error") == true, "severity_meets: critical meets error")
	check(severity_meets_threshold("warning", "error") == false, "severity_meets: warning below error")
	check(severity_meets_threshold("info", "error") == false, "severity_meets: info below error")
}

func test_parse_fail_on() {
	check_eq(parse_fail_on(array("check", "--fail-on", "warning", "http://localhost:3000")), "warning", "parse_fail_on: warning")
	check_eq(parse_fail_on(array("check", "http://localhost:3000")), "error", "parse_fail_on: default error")
	check_eq(parse_fail_on(array("check", "--fail-on", "invalid", "http://localhost:3000")), "error", "parse_fail_on: invalid falls back to default")
}

# ============================================================
# Exit Code Tests
# ============================================================

func test_exit_code_constants() {
	check_eq(EXIT_OK, 0, "exit_code: EXIT_OK is 0")
	check_eq(EXIT_CHECK_FAIL, 1, "exit_code: EXIT_CHECK_FAIL is 1")
	check_eq(EXIT_INVALID_INPUT, 2, "exit_code: EXIT_INVALID_INPUT is 2")
	check_eq(EXIT_BROWSER_FAIL, 3, "exit_code: EXIT_BROWSER_FAIL is 3")
	check_eq(EXIT_ARTIFACT_FAIL, 4, "exit_code: EXIT_ARTIFACT_FAIL is 4")
}

# ============================================================
# Check Result Tests
# ============================================================

func test_new_check_result() {
	cr := new_check_result("Test Check", "test_check")
	check_eq(cr["name"], "Test Check", "new_check_result: name set")
	check_eq(cr["id"], "test_check", "new_check_result: id set")
	check_eq(cr["status"], "pass", "new_check_result: default status pass")
	check_eq(cr["severity"], "info", "new_check_result: default severity info")
	check(len(cr["findings"]) == 0, "new_check_result: no findings initially")
}

func test_add_finding_error() {
	cr := new_check_result("Test", "test")
	f := new_finding("error", "TEST", "Test Error", "Something broke", "evidence-1", "Fix the error.")
	cr = add_finding(cr, f)
	check_eq(cr["status"], "fail", "add_finding: error makes status fail")
	check_eq(cr["severity"], "error", "add_finding: error severity propagated")
	check(len(cr["findings"]) == 1, "add_finding: finding added")
}

func test_add_finding_critical() {
	cr := new_check_result("Test", "test")
	f := new_finding("critical", "TEST", "Critical", "Critical issue", "evidence-1", "Fix the critical issue.")
	cr = add_finding(cr, f)
	check_eq(cr["status"], "fail", "add_finding: critical makes status fail")
	check_eq(cr["severity"], "critical", "add_finding: critical severity propagated")
}

func test_add_finding_warning() {
	cr := new_check_result("Test", "test")
	f := new_finding("warning", "TEST", "Test Warning", "Something minor", "evidence-1", "Check the warning.")
	cr = add_finding(cr, f)
	check_eq(cr["status"], "fail", "add_finding: warning makes status fail")
	check_eq(cr["severity"], "warning", "add_finding: warning severity propagated")
}

func test_add_finding_info() {
	cr := new_check_result("Test", "test")
	f := new_finding("info", "TEST", "Info", "FYI", "evidence-1", "No action needed.")
	cr = add_finding(cr, f)
	check_eq(cr["status"], "pass", "add_finding: info keeps status pass")
	check_eq(cr["severity"], "info", "add_finding: info severity stays")
}

func test_worst_severity() {
	cr1 := new_check_result("A", "a")
	cr1 = add_finding(cr1, new_finding("info", "TEST", "Info", "FYI", "", ""))
	
	cr2 := new_check_result("B", "b")
	cr2 = add_finding(cr2, new_finding("error", "TEST", "Error", "Error occurred", "", ""))
	
	cr3 := new_check_result("C", "c")
	cr3 = add_finding(cr3, new_finding("warning", "TEST", "Warning", "Warn", "", ""))
	
	results := array(cr1, cr2, cr3)
	check_eq(worst_severity(results), "error", "worst_severity: error is worst")
}

func test_worst_severity_critical_wins() {
	cr1 := new_check_result("A", "a")
	cr1 = add_finding(cr1, new_finding("error", "TEST", "Error", "Error", "", ""))
	
	cr2 := new_check_result("B", "b")
	cr2 = add_finding(cr2, new_finding("critical", "TEST", "Critical", "Critical", "", ""))
	
	results := array(cr1, cr2)
	check_eq(worst_severity(results), "critical", "worst_severity: critical wins over error")
}

# ============================================================
# Report Tests
# ============================================================

func test_generate_markdown_report() {
	config := {
		"url": "http://localhost:3000",
		"viewports": array("desktop", "mobile"),
		"version": LENS_VERSION
	}
	meta := {
		"status": "PASS",
		"started_at": "2026-05-31T00:00:00Z",
		"finished_at": "2026-05-31T00:00:01Z",
		"duration_ms": 1000,
		"out_dir": ".lens/runs/test",
		"exit_code": 0,
		"artifacts": array()
	}
	cr := new_check_result("Test", "test")
	cr = add_finding(cr, new_finding("info", "TEST", "Info", "Test finding", "", ""))
	check_results := array(cr)
	
	report := generate_markdown_report(config, meta, check_results)
	check(report != "", "generate_markdown_report: produces output")
	check(is_trueish(contains(report, "# Lens Report")), "generate_markdown_report: has title")
	check(is_trueish(contains(report, "Status: PASS")), "generate_markdown_report: has status")
	check(is_trueish(contains(report, "http://localhost:3000")), "generate_markdown_report: has URL")
}

func test_generate_json_report() {
	config := {
		"url": "http://localhost:3000",
		"viewports": array("desktop"),
		"version": LENS_VERSION,
		"fail_on": "error",
		"allow_external": false,
		"check_links": false,
		"timeout": 30
	}
	meta := {
		"status": "PASS",
		"started_at": "2026-05-31T00:00:00Z",
		"finished_at": "2026-05-31T00:00:01Z",
		"duration_ms": 1000,
		"out_dir": ".lens/runs/test",
		"exit_code": 0,
		"artifacts": array()
	}
	cr := new_check_result("Test", "test")
	cr = add_finding(cr, new_finding("info", "TEST", "Info", "Test", "", ""))
	check_results := array(cr)
	
	report := generate_json_report(config, meta, check_results, {})
	check(report != "", "generate_json_report: produces output")
	check(is_trueish(contains(report, "\"status\"")), "generate_json_report: has status field")
	check(is_trueish(contains(report, "\"url\"")), "generate_json_report: has url field")
}

# ============================================================
# Redaction Tests
# ============================================================

func test_is_sensitive_header() {
	check(is_sensitive_header("Authorization") == true, "redact: Authorization is sensitive")
	check(is_sensitive_header("Cookie") == true, "redact: Cookie is sensitive")
	check(is_sensitive_header("X-API-Key") == true, "redact: X-API-Key is sensitive")
	check(is_sensitive_header("Content-Type") == false, "redact: Content-Type is not sensitive")
	check(is_sensitive_header("Accept") == false, "redact: Accept is not sensitive")
}

func test_is_sensitive_query_param() {
	check(is_sensitive_query_param("token") == true, "redact: token is sensitive")
	check(is_sensitive_query_param("access_token") == true, "redact: access_token is sensitive")
	check(is_sensitive_query_param("api_key") == true, "redact: api_key is sensitive")
	check(is_sensitive_query_param("password") == true, "redact: password is sensitive")
	check(is_sensitive_query_param("q") == false, "redact: q is not sensitive")
	check(is_sensitive_query_param("page") == false, "redact: page is not sensitive")
}

func test_redact_url_sensitive_params() {
	redacted := redact_url("https://example.com/api?token=secret123&page=1&api_key=abc")
	check(is_trueish(contains(redacted, "[REDACTED]")), "redact_url: sensitive params redacted")
	check(is_falseish(contains(redacted, "secret123")), "redact_url: token value removed")
	check(is_falseish(contains(redacted, "abc")), "redact_url: api_key value removed")
	check(is_trueish(contains(redacted, "page=1")), "redact_url: non-sensitive param preserved")
}

func test_redact_url_no_params() {
	redacted := redact_url("https://example.com/page")
	check_eq(redacted, "https://example.com/page", "redact_url: no params returns unchanged")
}

func test_redact_header_value() {
	check_eq(redact_header_value("Authorization", "Bearer token123"), "[REDACTED]", "redact_header_value: sensitive header redacted")
	check_eq(redact_header_value("Content-Type", "application/json"), "application/json", "redact_header_value: non-sensitive header preserved")
}

