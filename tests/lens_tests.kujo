func test_phase3_flags() {
	check_eq(is_html(array("check", "http://localhost:3000")), false, "html: default off")
	check_eq(is_html(array("check", "--html", "http://localhost:3000")), true, "html: enabled")
	check_eq(is_watch(array("check", "--watch", "http://localhost:3000")), true, "watch: enabled")
	check_eq(parse_watch_interval(array("check", "http://localhost:3000")), 5, "watch-interval: default 5")
	check_eq(parse_watch_interval(array("check", "--watch-interval", "30", "http://localhost:3000")), 30, "watch-interval: custom")
	check_eq(parse_ledger(array("check", "--ledger", "/x/l.json", "http://localhost:3000")), "/x/l.json", "ledger: path")
	check_eq(parse_howl(array("check", "--howl", "/x/h.json", "http://localhost:3000")), "/x/h.json", "howl: path")
}

func test_html_escape() {
	check_eq(html_escape("<script>"), "&lt;script&gt;", "html_escape: angle brackets")
	check_eq(html_escape("a & b"), "a &amp; b", "html_escape: ampersand")
	check_eq(html_escape("say \"hi\""), "say &quot;hi&quot;", "html_escape: quotes")
	check_eq(html_escape("plain text"), "plain text", "html_escape: passthrough")
	# Regression: multi-byte input must not crash (len is bytes, index is chars).
	check_eq(html_escape("Free Tools → Plan. Prompt. Publish."), "Free Tools → Plan. Prompt. Publish.", "html_escape: UTF-8 arrow safe")
	check_eq(html_escape("café <b>"), "café &lt;b&gt;", "html_escape: accented char + escape")
}

func test_generate_html_report() {
	config := { "url": "http://localhost:3000", "viewports": array("desktop"), "version": "0.7.0" }
	meta := { "status": "FAIL", "started_at": "t0", "finished_at": "t1", "duration_ms": 1200, "exit_code": 1, "out_dir": "/tmp/x", "artifacts": array("lens-report.md", "screenshots/desktop.png") }
	check_results := array({
		"name": "Console Errors", "id": "console_errors", "status": "fail", "severity": "error", "finding_count": 1,
		"findings": array({ "id": "LENS-CONSOLE-001", "severity": "error", "title": "Console error", "description": "Boom <x>", "evidence": "console.json", "suggested_repair_task": "Fix it" })
	})
	html := generate_html_report(config, meta, check_results)
	check(is_trueish(contains(html, "<!doctype html>")), "html report: has doctype")
	check(is_trueish(contains(html, "FAIL")), "html report: shows status")
	check(is_trueish(contains(html, "LENS-CONSOLE-001")), "html report: shows finding id")
	check(is_trueish(contains(html, "Boom &lt;x&gt;")), "html report: escapes finding description")
	check(is_trueish(contains(html, "screenshots/desktop.png")), "html report: references screenshot")
}

